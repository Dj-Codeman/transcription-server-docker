# Storage mode: mounted
# Persists to a filesystem path mounted into the container (e.g. a
# `docker run -v /host/path:/workspace` bind mount or a named volume).

APP_STORAGE_MODE=mounted
APP_STORAGE_ROOT=/workspace

# Path checked/written by scripts/validate-storage.sh at startup.
# Defaults to APP_STORAGE_ROOT if unset.
APP_STORAGE_MOUNT_PATH=/workspace

# Set to "true" to skip the startup write check for a read-only mount.
APP_STORAGE_READONLY=false

# --- Whisper service ---
WHISPER_MODEL=base
WHISPER_BACKEND=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_PORT=8000
# Long audio is split into chunks and transcribed in parallel; see README
# "chunk_seconds / chunk_overlap_seconds" for details. Defaults shown below.
# WHISPER_CHUNK_SECONDS=1200
# WHISPER_CHUNK_OVERLAP_SECONDS=5
# WHISPER_CPU_MAX_WORKERS=              # defaults to cpu_count() // 2
# WHISPER_GPU_MAX_WORKERS=              # optional hard cap on the auto-sized GPU pool
# WHISPER_GPU_VRAM_BUFFER_INSTANCES=1

# --- Tailscale ---
TS_AUTHKEY=tskey-auth-xxxxxxxxxx
# tailscale serve --service requires a tagged node; tag must exist in your
# tailnet ACL (tagOwners) and be permitted for this auth key.
TS_TAGS=tag:whisper-api
TS_HOSTNAME=whisper-api
TS_SERVICE_NAME=svc:whisper
TS_SERVE_PORT=8000

# Remember to mount the host directory when running the container, e.g.:
#   docker run --env-file .env.mounted -v /host/transcripts:/workspace ...
