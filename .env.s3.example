# Storage mode: s3
# Persists to an S3-compatible bucket (AWS S3, MinIO, R2, etc).
#
# Full contract required by scripts/validate-storage.sh — set these
# directly if you already know endpoint/bucket/prefix:

APP_STORAGE_MODE=s3
APP_STORAGE_ROOT=/workspace

APP_STORAGE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
APP_STORAGE_S3_BUCKET=my-transcripts-bucket
APP_STORAGE_S3_REGION=us-east-1
APP_STORAGE_S3_PREFIX=sessions/manual
APP_STORAGE_S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
APP_STORAGE_S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_STORAGE_S3_PATH_STYLE=true
# APP_STORAGE_S3_SESSION_TOKEN=            # only needed for temporary/STS creds

# --- Alternative: minimal form ---
# scripts/derive-storage-env.sh can fill in endpoint/bucket/prefix from a
# single URL instead of the block above. To use it, comment out the
# ENDPOINT/BUCKET/PREFIX/REGION/PATH_STYLE lines and set:
#
# APP_STORAGE_S3_URL=https://s3.us-east-1.amazonaws.com/my-transcripts-bucket
# APP_STORAGE_S3_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
# APP_STORAGE_S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Whisper service ---
WHISPER_MODEL=base
WHISPER_BACKEND=auto
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_PORT=8000
# Long audio is split into chunks and transcribed in parallel; see README
# "chunk_seconds / chunk_overlap_seconds" for details. Defaults shown below.
# WHISPER_CHUNK_SECONDS=1200
# WHISPER_CHUNK_OVERLAP_SECONDS=5
# WHISPER_CPU_MAX_WORKERS=              # defaults to cpu_count() // 2
# WHISPER_GPU_MAX_WORKERS=              # optional hard cap on the auto-sized GPU pool
# WHISPER_GPU_VRAM_BUFFER_INSTANCES=1

# --- Tailscale ---
TS_AUTHKEY=tskey-auth-xxxxxxxxxx
# tailscale serve --service requires a tagged node; tag must exist in your
# tailnet ACL (tagOwners) and be permitted for this auth key.
TS_TAGS=tag:whisper-api
TS_HOSTNAME=whisper-api
TS_SERVICE_NAME=svc:whisper
TS_SERVE_PORT=8000
